# Optional database path. Default: data/jobs.sqlite.
# Streamlit reads the actual process environment; .env is not loaded automatically.
JOB_HUNTER_DB=

# Optional. Alternatively enter the key in the masked field in the app (session only).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional additional OpenAI-compatible provider after Groq failures. All three required.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
